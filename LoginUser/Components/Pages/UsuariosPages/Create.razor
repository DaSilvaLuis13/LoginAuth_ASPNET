@page "/usuarios/create"
@using LoginUser.Models
@using LoginUser.Models.Entities
@using Microsoft.EntityFrameworkCore
@inject IDbContextFactory<LoginUser.Data.LoginUserContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Create</PageTitle>

<h1>Create</h1>

<h2>Usuarios</h2>
<hr />
<div class="row">
    <div class="col-md-4">
        <EditForm method="post" Model="Usuarios" OnValidSubmit="AddUsuarios" FormName="create" Enhance>
            <DataAnnotationsValidator />
            <ValidationSummary class="text-danger" role="alert"/>
            <div class="mb-3">
                <span class="text-danger">*</span>
                <label for="nombre" class="form-label">Nombre:</label> 
                <InputText id="nombre" @bind-Value="Usuarios.Nombre" class="form-control" aria-required="true"/> 
                <ValidationMessage For="() => Usuarios.Nombre" class="text-danger" /> 
            </div>        
            <div class="mb-3">
                <span class="text-danger">*</span>
                <label for="correo" class="form-label">Correo:</label> 
                <InputText id="correo" @bind-Value="Usuarios.Correo" class="form-control" aria-required="true"/> 
                <ValidationMessage For="() => Usuarios.Correo" class="text-danger" /> 
            </div>        
            <div class="mb-3">
                <span class="text-danger">*</span>
                <label for="password_hash" class="form-label">Password:</label> 
                <InputText id="password_hash" @bind-Value="Usuarios.Password" class="form-control" aria-required="true"/> 
                <ValidationMessage For="() => Usuarios.Password" class="text-danger" /> 
            </div>        
            <div class="mb-3">
                <span class="text-danger">*</span>
                <label for="rolid" class="form-label">RolId:</label> 
                <InputNumber id="rolid" @bind-Value="Usuarios.RolId" class="form-control" aria-required="true"/> 
                <ValidationMessage For="() => Usuarios.RolId" class="text-danger" /> 
            </div>        
            <button type="submit" class="btn btn-primary">Create</button>
        </EditForm>
    </div>
</div>

<div>
    <a href="/usuarios">Back to List</a>
</div>

@code {
    [SupplyParameterFromForm]
    private Usuarios Usuarios { get; set; } = new();

    // To protect from overposting attacks, see https://learn.microsoft.com/aspnet/core/blazor/forms/#mitigate-overposting-attacks.
    private async Task AddUsuarios()
    {
        using var context = DbFactory.CreateDbContext();
        context.Usuarios.Add(Usuarios);
        await context.SaveChangesAsync();
        NavigationManager.NavigateTo("/usuarios");
    }
}
