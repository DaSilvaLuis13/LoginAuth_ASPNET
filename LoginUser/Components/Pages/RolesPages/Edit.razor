@page "/roles/edit"
@using Microsoft.EntityFrameworkCore
@using LoginUser.Models
@inject IDbContextFactory<LoginUser.Data.LoginUserContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Edit</PageTitle>

<h1>Edit</h1>

<h2>Roles</h2>
<hr />
@if (Roles is null)
{
    <p><em>Loading...</em></p>
}
else
{
    <div class="row">
        <div class="col-md-4">
            <EditForm method="post" Model="Roles" OnValidSubmit="UpdateRoles" FormName="edit" Enhance>
                <DataAnnotationsValidator />
                <ValidationSummary role="alert"/>
                <input type="hidden" name="Roles.Id" value="@Roles.Id" />
                <div class="mb-3">
                <span class="text-danger">*</span>
                    <label for="nombre" class="form-label">Nombre:</label>
                    <InputText id="nombre" @bind-Value="Roles.Nombre" class="form-control" aria-required="true"/>
                    <ValidationMessage For="() => Roles.Nombre" class="text-danger" />
                </div>
                <div class="mb-3">
                <span class="text-danger">*</span>
                    <label for="descripcion" class="form-label">Descripcion:</label>
                    <InputText id="descripcion" @bind-Value="Roles.Descripcion" class="form-control" aria-required="true"/>
                    <ValidationMessage For="() => Roles.Descripcion" class="text-danger" />
                </div>
                <div class="mb-3">
                <span class="text-danger">*</span>
                    <label for="estado" class="form-label">Estado:</label>
                    <InputCheckbox id="estado" @bind-Value="Roles.Estado" class="form-check-input" aria-required="true"/>
                    <ValidationMessage For="() => Roles.Estado" class="text-danger" />
                </div>
                <div class="mb-3">
                <span class="text-danger">*</span>
                    <label for="fechacreacion" class="form-label">FechaCreacion:</label>
                    <InputDate id="fechacreacion" @bind-Value="Roles.FechaCreacion" class="form-control" aria-required="true"/>
                    <ValidationMessage For="() => Roles.FechaCreacion" class="text-danger" />
                </div>
                <button type="submit" class="btn btn-primary">Save</button>
            </EditForm>
        </div>
    </div>
}

<div>
    <a href="/roles">Back to List</a>
</div>

@code {
    [SupplyParameterFromQuery]
    private int Id { get; set; }

    [SupplyParameterFromForm]
    private Roles? Roles { get; set; }

    protected override async Task OnInitializedAsync()
    {
        using var context = DbFactory.CreateDbContext();
        Roles ??= await context.Roles.FirstOrDefaultAsync(m => m.Id == Id);

        if (Roles is null)
        {
            NavigationManager.NavigateTo("notfound");
        }
    }

    // To protect from overposting attacks, enable the specific properties you want to bind to.
    // For more information, see https://learn.microsoft.com/aspnet/core/blazor/forms/#mitigate-overposting-attacks.
    private async Task UpdateRoles()
    {
        using var context = DbFactory.CreateDbContext();
        context.Attach(Roles!).State = EntityState.Modified;

        try
        {
            await context.SaveChangesAsync();
        }
        catch (DbUpdateConcurrencyException)
        {
            if (!RolesExists(Roles!.Id))
            {
                NavigationManager.NavigateTo("notfound");
            }
            else
            {
                throw;
            }
        }

        NavigationManager.NavigateTo("/roles");
    }

    private bool RolesExists(int id)
    {
        using var context = DbFactory.CreateDbContext();
        return context.Roles.Any(e => e.Id == id);
    }
}
